# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# --- Compose Desktop app ---
desktop/.gradle/
desktop/build/
desktop/.kotlin/

# --- Bundled VPN binaries (copied locally before build, not committed) ---
desktop/src/main/resources/bin/

# --- Local tooling / session data ---
.tools/
.zcode/
.freebuff/

# Banner drafts: intermediate renders stay local; the source HTML and the
# final PNG are tracked.
desktop/banners/drafts/*.png

# Local debug/scratch artifacts — never commit (contain live server data)
/mv-*.json
/mv-*.txt
/t1.txt
/baseline-tests.txt
/release-assets/
/ui-preview.html
/ui-themes-proposal.html
